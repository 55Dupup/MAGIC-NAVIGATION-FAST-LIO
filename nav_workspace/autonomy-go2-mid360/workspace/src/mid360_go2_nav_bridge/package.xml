<?xml version="1.0"?>
<package format="3">
  <name>mid360_go2_nav_bridge</name>
  <version>0.1.0</version>
  <description>Bridge FAST-LIO MID360 topics into autonomy_stack_go2 navigation topics.</description>
  <maintainer email="unitree@example.com">unitree</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>demo_nodes_cpp</exec_depend>

  <exec_depend>local_planner</exec_depend>
  <exec_depend>terrain_analysis</exec_depend>
  <exec_depend>terrain_analysis_ext</exec_depend>
  <exec_depend>far_planner</exec_depend>
  <exec_depend>vehicle_simulator</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
